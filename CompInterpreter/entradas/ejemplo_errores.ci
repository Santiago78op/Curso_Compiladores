// Archivo con errores A PROPOSITO: uno lexico, uno sintactico, varios semanticos.
// Sirve para probar el reporte de errores (seccion 6.1).

// (1) Error LEXICO: el caracter '#' no pertenece al lenguaje
let a: int = 10 # 5;

// (2) Error SINTACTICO: falta el punto y coma / expresion mal formada
let b: int = ;

// declaraciones validas para las pruebas semanticas
let texto: string = "hola";
let bandera: bool = true;

function void main() {
    // (3) Error SEMANTICO: resta entre CADENA y CADENA no esta permitida (5.5.2)
    let mala: string = texto - "mundo";

    // (4) Error SEMANTICO: variable no declarada
    echo noExiste;

    // (5) Error SEMANTICO: reasignar una constante
    // (const declarada abajo)
    ci = 5;

    // (6) Error SEMANTICO: condicion de if no booleana
    if (10 + 2) {
        echo "no deberia";
    }

    // (7) Error SEMANTICO: orden entre BOOLEAN no permitido (decision de disenio 5.6)
    let x: bool = bandera > true;

    // (8) Error SEMANTICO (M2): un metodo (void) no puede usarse como expresion
    let v: int = saludar();

    // (9) Error SEMANTICO (M3): un metodo (void) no puede retornar un valor
    conRetorno();

    // (10) Error SEMANTICO (M1): indice de vector que no es ENTERO
    let vec: int[] = new vector int[3];
    echo vec["cero"];

    // (11) Error SEMANTICO (M4): nativa numerica sobre un vector con nulos
    echo sum(vec);

    // (12) Error SEMANTICO (B1): char NO se coerciona implicitamente a double
    // (char->double solo con cast explicito, seccion 5.13)
    let ch: char = 'A';
    let dd: double = ch;
}

const ci: int = 99;

// metodo void usado mal arriba (M2)
function void saludar() {
    echo "hola";
}

// metodo void con un return valuado invalido (M3)
function void conRetorno() {
    return 7;
}

ejecutar main();
